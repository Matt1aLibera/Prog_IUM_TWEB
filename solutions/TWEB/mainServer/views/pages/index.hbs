<div id="mainContent">
    {{#if user}}
        <div class="welcome-message">
            <h2>Benvenuto {{user.username}}!</h2>
        </div>
    {{else}}
        <div class="text-center mt-5">
            <div class="spinner-border" role="status"></div>
            <p class="mt-2">Caricamento in corso...</p>
        </div>
    {{/if}}
</div>