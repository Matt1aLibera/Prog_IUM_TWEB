<div class="welcome-message">
    <h2 id="welcomeMessage"></h2>
</div>

<!-- Sezione principale dinamica -->
<div id="dynamicContent">
    <!-- Carosello - sezione visibile inizialmente -->
    <div id="carouselSection" class="{{#unless showCarousel}}d-none{{/unless}}">
        {{#if films.length}}
            <div id="filmCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    {{#each films}}
                        <div class="carousel-item {{#if @first}}active{{/if}}">
                            <div class="film-poster-container" data-film-id="{{this.id}}">
                                <img src="{{this.posterUrl}}" class="d-block w-100" alt="{{this.title}}">
                                <div class="film-info-overlay">
                                    <h5>{{this.title}}</h5>
                                    <div class="rating">
                                        <span class="star">★</span>
                                        <span>{{this.rating}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{/each}}
                </div>
                <!-- Controlli carosello -->
                <button class="carousel-control-prev" type="button" data-bs-target="#filmCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#filmCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        {{else}}
            <div class="alert alert-warning">Nessun film disponibile al momento</div>
        {{/if}}
    </div>
    <!-- Risultati ricerca - visibili solo durante la ricerca -->
    <div id="searchResultsSection" class="{{#unless showSearchResults}}d-none{{/unless}}">
        {{{searchResults}}}
    </div>
    <!-- Sezione chat - visibile solo quando richiesto -->
    <div id="chatSection" class="{{#unless showChat}}d-none{{/unless}}">
        {{{chatContent}}}
    </div>
    <!--  pagina form ricerca avanzata -->
    <div id="advancedSearchSection" class="{{#unless showAdvancedSearch}}d-none{{/unless}}">
        {{{advancedSearchContent}}}
    </div>
    <!-- Sezione risultati recensioni -->
    <div id="reviewResultsSection" class="hidden-section">
        <!-- Contenuto verrà inserito dinamicamente -->
    </div>
</div>
<!-- Sezione dettaglio film - inizialmente nascosta -->
<div id="filmDetailSection" class="film-detail-section d-none">
    <!-- Spinner di caricamento (solo per navigazione client-side) -->
    <div id="filmLoadingSpinner" class="text-center py-5">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-3">Caricamento film...</p>
    </div>

    <!-- Contenuto film -->
    <div id="filmContent" style="{{#unless filmDetails}}display: none;{{/unless}}">
        <button id="backToCarousel" class="btn btn-outline-secondary mb-4">
            <i class="bi bi-arrow-left"></i> Torna al carosello
        </button>

        <div class="film-container">
            <!-- Testata con poster e info base -->
            <div class="film-header">
                <div class="row g-4">
                    <div class="col-md-4">
                        {{#if filmDetails.poster.link}}
                            <img id="filmPoster"
                                 src="{{filmDetails.poster.link}}"
                                 class="img-fluid rounded-3 shadow"
                                 alt="{{filmDetails.movie.name}}"
                                 onerror="this.classList.add('placeholder'); this.removeAttribute('src');">
                        {{else}}
                            <div id="filmPoster" class="img-fluid rounded-3 shadow film-poster placeholder"></div>
                        {{/if}}
                    </div>
                    <div class="col-md-8">
                        <div class="film-meta p-4 rounded">
                            <h1 id="filmTitle" class="display-5 fw-bold">
                                {{#if filmDetails}}{{filmDetails.movie.name}}{{else}}N/D{{/if}}
                            </h1>
                            <p id="filmTagline" class="lead text-muted">
                                {{#if filmDetails}}{{filmDetails.movie.tagline}}{{/if}}
                            </p>

                            <div class="d-flex flex-wrap gap-2 mb-4">
                                <span class="badge rating-badge py-2 px-3">
                                    <i class="bi bi-star-fill me-1"></i>
                                    <span id="filmRating">
                                        {{#if filmDetails}}{{filmDetails.rating}}{{else}}N/D{{/if}}
                                    </span>/5
                                </span>
                                <span class="badge duration-badge py-2 px-3">
                                    <i class="bi bi-clock me-1"></i>
                                    <span id="filmDuration">
                                        {{#if filmDetails}}{{filmDetails.duration}}{{else}}N/D{{/if}}
                                    </span>
                                </span>
                                <div id="filmCountries" class="d-flex flex-wrap gap-2">
                                    {{#if filmDetails}}
                                        {{#each filmDetails.countries}}
                                            <span class="badge bg-secondary">{{this.countryName}}</span>
                                        {{/each}}
                                    {{/if}}
                                </div>
                            </div>

                            <div class="action-buttons mb-4">
                                <button class="btn btn-outline-secondary">
                                    <i class="bi bi-bookmark"></i> Salva
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contenuto principale -->
            <div class="film-body mt-5">
                <!-- Prima riga: Trama + Dettagli -->
                <div class="row mb-5">
                    <!-- Trama (sinistra) -->
                    <div class="col-lg-6 order-lg-1 order-2">
                        <section class="mb-5">
                            <h2 class="mb-3"><i class="bi bi-card-text me-2"></i>Trama</h2>
                            <p id="filmDescription" class="fs-5">
                                {{#if filmDetails}}{{filmDetails.movie.description}}{{else}}
                                    Nessuna descrizione disponibile{{/if}}
                            </p>
                        </section>

                        <!-- Cast -->
                        <section class="mb-5">
                            <h2 class="mb-3"><i class="bi bi-people-fill me-2"></i>Cast</h2>
                            <div class="scrollable-container">
                                <ul id="filmActors" class="list-group">
                                    {{#if filmDetails}}
                                        {{#each filmDetails.actors}}
                                            <li class="list-group-item">
                                                <strong>{{this.actorName}}</strong> as {{this.characterName}}
                                            </li>
                                        {{/each}}
                                    {{/if}}
                                </ul>
                            </div>
                        </section>

                        <!-- Crew -->
                        <section class="mb-5">
                            <h2 class="mb-3"><i class="bi bi-person-gear me-2"></i>Crew</h2>
                            <div class="scrollable-container">
                                <ul id="filmCrew" class="list-group">
                                    {{#if filmDetails}}
                                        {{#each filmDetails.crew}}
                                            <li class="list-group-item">
                                                <strong>{{this.name}}</strong> - {{this.role}}
                                            </li>
                                        {{/each}}
                                    {{/if}}
                                </ul>
                            </div>
                        </section>
                    </div>

                    <!-- Colonna destra -->
                    <div class="col-lg-6 order-lg-2 order-1">
                        <!-- Dettagli tecnici -->
                        <div class="card border-0 shadow-sm mb-5">
                            <div class="card-body">
                                <h3 class="h5 mb-3"><i class="bi bi-info-circle me-2"></i>Dettagli</h3>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Generi</span>
                                        <span id="filmGenres">
                                            {{#if filmDetails}}
                                                {{#each filmDetails.genres}}{{this.genre}}{{#unless @last}}, {{/unless}}{{/each}}
                                            {{else}}N/D{{/if}}
                                        </span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Studio</span>
                                        <div id="filmStudios">
                                            {{#if filmDetails}}
                                                {{#each filmDetails.studios}}{{this.studio}}{{#unless @last}}, {{/unless}}{{/each}}
                                            {{else}}N/D{{/if}}
                                        </div>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>Prima uscita</span>
                                        <span id="filmFirstRelease">
                                            {{#if filmDetails}}{{filmDetails.movie.date}}{{else}}N/D{{/if}}
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Premi Oscar -->
                        <section class="mb-5" id="oscarsSection">
                            <h2 class="mb-3"><i class="bi bi-trophy me-2"></i>Premi Oscar</h2>
                            <div id="oscarsLoading" class="text-center py-2">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                            </div>
                            <ul id="oscarsList" class="list-group d-none">
                                <!-- Popolato dinamicamente -->
                            </ul>
                            <div id="noOscars" class="alert alert-light d-none">
                                Nessun premio Oscar trovato
                            </div>
                        </section>

                        <!-- Release -->
                        <section class="mb-5">
                            <h2 class="mb-3"><i class="bi bi-calendar-event me-2"></i>Date di uscita</h2>
                            <div class="scrollable-container">
                                <ul id="filmReleases" class="list-group">
                                    {{#if filmDetails}}
                                        {{#each filmDetails.release}}
                                            <li class="list-group-item">
                                                {{this.country}} - {{this.date}} ({{this.type}})
                                            </li>
                                        {{/each}}
                                    {{/if}}
                                </ul>
                            </div>
                        </section>
                    </div>
                </div>
                <!-- Sezione Recensioni - In fondo alla pagina -->
                <div class="row mt-5">
                    <div class="col-12">
                        <section id="reviewsSection">
                            <h2 class="mb-4 border-bottom pb-2"><i class="bi bi-newspaper me-2"></i>Recensioni della Critica</h2>

                            <!-- Spinner di caricamento -->
                            <div id="reviewsLoading" class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Caricamento recensioni...</p>
                            </div>

                            <!-- Filtri (da implementare successivamente) -->
                            <div id="reviewsFilters" class="row mb-3 d-none">
                                <div class="col-md-6">
                                    <label for="ratingFilter" class="form-label">Filtra per valutazione</label>
                                    <select id="ratingFilter" class="form-select">
                                        <option value="all">Tutte le valutazioni</option>
                                        <option value="4">⭐ 4+ stelle</option>
                                        <option value="3">⭐ 3+ stelle</option>
                                        <option value="2">⭐ 2+ stelle</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check mt-4 pt-2">
                                        <input class="form-check-input" type="checkbox" id="topCriticsOnly">
                                        <label class="form-check-label" for="topCriticsOnly">
                                            Solo Top Critics
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Container recensioni -->
                            <div id="reviewsList" class="row g-3">
                                <!-- Popolato dinamicamente -->
                            </div>

                            <!-- Messaggio nessuna recensione -->
                            <div id="noReviews" class="alert alert-light text-center d-none">
                                Nessuna recensione disponibile per questo film
                            </div>

                            <!-- Pulsante "Carica più" -->
                            <div class="text-center mt-4">
                                <button id="loadMoreReviews" class="btn btn-outline-primary d-none">
                                    <i class="bi bi-arrow-down-circle me-2"></i>Carica altre recensioni
                                </button>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{#if filmDetails}}
    <script>
        // Solo per accesso diretto: integrazione con logica esistente
        document.addEventListener('DOMContentLoaded', () => {
            // Nascondi spinner (non necessario in render server-side)
            document.getElementById('filmLoadingSpinner').style.display = 'none';

            // Se la navigazione è client-side, i dati verranno gestiti dalle tue funzioni esistenti
            // Se è un accesso diretto, il contenuto è già renderizzato dal server

            // Aggiungi comunque i listener per mantenere la funzionalità
            document.getElementById('backToCarousel')?.addEventListener('click', backToPreviousView);

            // Nascondi le altre sezioni (come farebbero le tue funzioni)
            document.getElementById('carouselSection').classList.add('d-none');
            document.getElementById('searchResultsSection').classList.add('d-none');
            document.getElementById('filmDetailSection').classList.remove('d-none');
        });
    </script>
{{/if}}