<div class="chat-page-container mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-chat-left-text"></i> Chat Community</h2>
    </div>

    <!-- Corpo principale -->
    <div class="row">
        <!-- Sidebar stanze -->
        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Stanze disponibili</h5>
                    <div class="small" id="currentUserBadge">Utente: Caricamento...</div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" id="roomsList">
                        {{#each activeRooms}}
                            <a href="#" class="list-group-item list-group-item-action room-item"
                               data-room-id="{{id}}" data-room-type="{{type}}">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>
                                        <i class="bi bi-{{roomIcon type}} me-2"></i>
                                        {{name}}
                                    </span>
                                </div>
                            </a>
                        {{/each}}
                    </div>
                </div>
                <div class="card-footer">
                    <button id="createRoomBtn" class="btn btn-sm btn-success w-100">
                        <i class="bi bi-plus-circle"></i> Crea nuova stanza
                    </button>
                </div>
            </div>
        </div>

        <!-- Area chat -->
        <div class="col-md-8 col-lg-9">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between">
                    <h5 id="currentRoomTitle" class="mb-0">Seleziona una stanza</h5>
                    <button id="leaveRoomBtn" class="btn btn-sm btn-danger d-none">
                        <i class="bi bi-box-arrow-left"></i> Esci
                    </button>
                    <div id="roomUsers" class="small"></div>
                </div>
                <div id="messagesContainer" class="card-body chat-messages">
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-chat-square-text" style="font-size: 3rem;"></i>
                        <p class="mt-3">Seleziona una stanza per iniziare a chattare</p>
                    </div>
                </div>

                <div class="card-footer d-none" id="messageInputContainer">
                    <div class="input-group">
                        <input type="text" id="messageInput" class="form-control" placeholder="Scrivi un messaggio..." disabled>
                        <button id="sendMessageBtn" class="btn btn-primary" disabled>
                            <i class="bi bi-send"></i> Invia
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal per creazione stanza -->
<div id="createRoomModal" class="modal-custom">
    <div class="modal-content-custom">
        <div class="modal-header">
            <h5>Crea nuova stanza</h5>
            <button type="button" class="close-modal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label for="roomNameInput">Nome stanza:</label>
                <input type="text" id="roomNameInput" class="form-control"
                       maxlength="50" required placeholder="Inserisci un nome (max 50 caratteri)">
            </div>
            <div class="mb-3">
                <label for="roomTopicSelect">Argomento:</label>
                <select id="roomTopicSelect" class="form-select" required>
                    <option value="" disabled selected>Seleziona un argomento</option>
                    <option value="film">Film</option>
                    <option value="attore">Attore</option>
                    <option value="crew">Crew</option>
                    <option value="personaggio">Personaggio</option>
                    <option value="generale">Generale</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="roomCodeInput">Codice stanza (opzionale):</label>
                <input type="text" id="roomCodeInput" class="form-control"
                       placeholder="Lascia vuoto per generare automaticamente">
            </div>
        </div>
        <div class="modal-footer">
            <button id="confirmCreateRoom" class="btn btn-primary">Crea</button>
            <button class="btn btn-secondary close-modal">Annulla</button>
        </div>
    </div>
</div>

<!-- Modal per unione a stanza -->
<div id="joinRoomModal" class="modal-custom">
    <div class="modal-content-custom">
        <div class="modal-header">
            <h5>Unisciti a stanza</h5>
            <button type="button" class="close-modal">&times;</button>
        </div>
        <div class="modal-body">
            <div class="mb-3">
                <label>Codice stanza:</label>
                <input type="text" id="joinRoomCode" class="form-control">
            </div>
        </div>
        <div class="modal-footer">
            <button id="confirmJoin" class="btn btn-primary">Unisciti</button>
            <button class="btn btn-secondary close-modal">Annulla</button>
        </div>
    </div>
</div>