<!DOCTYPE html>
<html>
<head>
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
{{> navbar}}

<div class="container mt-4" id="mainContent">
    {{{body}}}
</div>

<!-- Carica prima le dipendenze globali -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<!-- Configurazione Axios -->
<script>
    axios.defaults.withCredentials = true;
    axios.defaults.headers.common['X-Requested-With'] = 'XMLHttpRequest';
</script>

<!-- Carica i moduli in ordine corretto -->
<script type="module" src="/javascripts/filmCarousel.js"></script>
<script type="module" src="/javascripts/auth.js"></script>

<!-- Fallback per browser vecchi -->
<script nomodule>
    console.warn("Aggiorna il tuo browser per una migliore esperienza");
</script>
</body>
</html>