<!DOCTYPE html>
<html>
<head>
    <title>{{title}}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <style>
        .hidden-section {
            display: none;
        }
    </style>
</head>
<body>
{{> navbar}}

<div class="container mt-4">
    <!-- Tutte le sezioni sempre presenti -->
    <div id="authFormsSection">
        {{> form}}
    </div>

    <div id="dashboardSection" class="hidden-section">
        {{{body}}}
    </div>

    <div id="loaderSection" class="text-center mt-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Caricamento in corso...</p>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
    axios.defaults.withCredentials = true;
    axios.defaults.headers.common['X-Requested-With'] = 'XMLHttpRequest';
</script>

<script type="module" src="/javascripts/auth.js"></script>
</body>
</html>